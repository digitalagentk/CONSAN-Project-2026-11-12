# ============================================================
# CONSAN - Environment Variables Template
# Copy this file to .env and fill in real values.
# ============================================================

# --- Database ---
MSSQL_SA_PASSWORD=<strong-password-min-8-chars-with-symbols>
MSSQL_APP_PASSWORD=<strong-app-password-here>

# --- Admin ---
ADMIN_PASSWORD=<strong-admin-password-here>

# --- Connection Strings ---
# App uses consan_app user (limited privileges)
CONNECTION_STRING=Server=consan_sqlserver,1433;Database=ConsanDb;User Id=consan_app;Password=<app-password>;TrustServerCertificate=True;MultipleActiveResultSets=true

# Migrations use sa (full privileges)
MIGRATION_CONNECTION_STRING=Server=consan_sqlserver,1433;Database=ConsanDb;User Id=sa;Password=<sa-password>;TrustServerCertificate=True;MultipleActiveResultSets=true

# --- Server ---
ASPNETCORE_URLS=http://0.0.0.0:8080
ASPNETCORE_ENVIRONMENT=Production